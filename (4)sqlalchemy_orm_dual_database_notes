4. ORM CRUD QUERIES & ATOMIC TRANSACTIONS IN FASTAPI
================================================================================
Real restaurant operations touch multiple tables at once. For example, when a customer places a QR order:
1. Verify the table exists in MySQL.
2. Create the parent `Order` row.
3. Loop through items, look up live prices from `MenuItem`, and create `OrderItem` rows.
4. Update `RestaurantTable.status` to `"Ordering"` and award loyalty points.
5. Commit MySQL atomically (`db.commit()`)—if anything fails, `db.rollback()` undoes partial writes!
6. Write an audit record into SQLite (`audit_db.add(...)`).

```python
from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.orm import Session
from backend.database import get_db, get_audit_db
from backend.models import RestaurantTable, MenuItem, Order, OrderItem, ActivityLog
from backend.schemas import OrderCreate

router = APIRouter(prefix="/api/orders", tags=["Orders"])

@router.post("/", status_code=status.HTTP_201_CREATED)
def place_customer_order(
    payload: OrderCreate,
    db: Session = Depends(get_db),
    audit_db: Session = Depends(get_audit_db)
):
    # 1. Verify Table Exists
    table = db.query(RestaurantTable).filter(RestaurantTable.id == payload.table_id).first()
    if not table:
        raise HTTPException(status_code=404, detail="Table not found")

    try:
        # 2. Create Parent Order
        new_order = Order(table_id=table.id, status="Placed")
        db.add(new_order)
        db.flush()  # Generates new_order.id before final commit

        # 3. Create Child Order Items
        for item in payload.items:
            dish = db.query(MenuItem).filter(
                MenuItem.id == item.menu_item_id,
                MenuItem.is_available == True
            ).first()
            if not dish:
                raise HTTPException(status_code=404, detail=f"Dish ID {item.menu_item_id} unavailable")

            price = dish.price_half if (item.portion_size == "Half" and dish.price_half) else dish.price_full

            order_item = OrderItem(
                order_id=new_order.id,
                menu_item_id=dish.id,
                quantity=item.quantity,
                portion_size=item.portion_size,
            spice_choice=item.spice_choice,
unit_price=price
)
db.add(order_item)
# 4. Update Table Status & Points
table.status = "Ordering"
table.current_points += 20
# 5. Atomic Commit to MySQL
db.commit()
db.refresh(new_order)
except HTTPException:
db.rollback()
raise
except Exception as exc:
db.rollback()
raise HTTPException(status_code=500, detail=f"Database error: {str(exc)}")
# 6. Log Event to SQLite Audit Database
log_entry = ActivityLog(
actor_role="customer",
actor_id=table.id,
action="ORDER_PLACED",
details=f"Table {table.table_number} placed Order #{new_order.id} ({len(payload.items)} items)"
)
audit_db.add(log_entry)
audit_db.commit()
return {"message": "Order placed successfully", "order_id": new_order.id, "status": new_order.status}
```
Common SQLAlchemy Query Patterns Cheat Sheet:
• Fetch all records: db.query(MenuItem).all()
• Filter with multiple conditions: db.query(MenuItem).filter(MenuItem.is_veg == True, MenuItem.is_available == True).all()
• Fetch single record or None: db.query(Order).filter(Order.id == order_id).first()
• Delete a record:
  python dish = db.query(MenuItem).filter(MenuItem.id == item_id).first() if dish: db.delete(dish) db.commit()   

