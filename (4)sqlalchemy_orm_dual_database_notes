3. DEFINING ORM MODELS & RELATIONSHIPS (`backend/models.py`)
================================================================================
Each Python class inheriting from `Base` becomes a table in MySQL, while classes inheriting from `AuditBase` become tables in SQLite. `relationship()` links parent and child objects together in Python.

```python
from datetime import datetime
from sqlalchemy import (
    Column, Integer, String, Float, Boolean, DateTime,
    ForeignKey, Enum, Text, Numeric
)
from sqlalchemy.orm import relationship
from backend.database import Base, AuditBase

# --- MYSQL CORE TABLES ---

class User(Base):
    __tablename__ = "users"
    id = Column(Integer, primary_key=True, index=True)
    full_name = Column(String(100), nullable=False)
    email = Column(String(120), unique=True, nullable=False, index=True)
    password_hash = Column(String(255), nullable=False)
    role = Column(Enum("staff", "kitchen", "owner", name="user_roles"), nullable=False)
    is_active = Column(Boolean, default=True)
    created_at = Column(DateTime, default=datetime.utcnow)

class RestaurantTable(Base):
    __tablename__ = "restaurant_tables"
    id = Column(Integer, primary_key=True, index=True)
    table_number = Column(String(10), unique=True, nullable=False)
    capacity = Column(Integer, default=4, nullable=False)
    qr_token = Column(String(64), unique=True, nullable=False)
    status = Column(
        Enum("Empty", "Ordering", "Eating", "Bill Requested", "Needs Help", name="table_status"),
        default="Empty"
    )
    current_points = Column(Integer, default=0)

    orders = relationship("Order", back_populates="table")

class MenuItem(Base):
    __tablename__ = "menu_items"
    id = Column(Integer, primary_key=True, index=True)
    name = Column(String(100), nullable=False)
    category = Column(Enum("Main Course", "Sides", "Drinks", "Deals", name="menu_cat"), nullable=False)
    kitchen_station = Column(Enum("Tandoor", "Curry", "Drinks", name="kds_station"), nullable=False)
    price_half = Column(Numeric(10, 2), nullable=True)
    price_full = Column(Numeric(10, 2), nullable=False)
    is_veg = Column(Boolean, default=True)
    spice_levels = Column(String(50), default="Mild,Medium,Hot")
    allergens = Column(String(100), nullable=True)
    deal_badge = Column(String(50), nullable=True)
    prep_time_mins = Column(Integer, default=15)
    image_url = Column(String(255), nullable=True)
    is_available = Column(Boolean, default=True)

class Order(Base):
    __tablename__ = "orders"
    id = Column(Integer, primary_key=True, index=True)
    table_id = Column(Integer, ForeignKey("restaurant_tables.id"), nullable=False)
    confirmed_by = Column(Integer, ForeignKey("users.id"), nullable=True)
    status = Column(
        Enum("Placed", "Confirmed", "Cooking", "Ready", "Served", "Closed", name="order_status"),
        default="Placed"
    )
    placed_at = Column(DateTime, default=datetime.utcnow)
    cooking_started_at = Column(DateTime, nullable=True)
    estimated_ready_at = Column(DateTime, nullable=True)

    table = relationship("RestaurantTable", back_populates="orders")
    items = relationship("OrderItem", back_populates="order", cascade="all, delete-orphan")

class OrderItem(Base):
    __tablename__ = "order_items"
    id = Column(Integer, primary_key=True, index=True)
    order_id = Column(Integer, ForeignKey("orders.id", ondelete="CASCADE"), nullable=False)
    menu_item_id = Column(Integer, ForeignKey("menu_items.id"), nullable=False)
    quantity = Column(Integer, nullable=False)
    portion_size = Column(Enum("Half", "Full", name="portion_enum"), default="Full")
    spice_choice = Column(Enum("Mild", "Medium", "Hot", name="spice_enum"), default="Medium")
    unit_price = Column(Numeric(10, 2), nullable=False)
    item_status = Column(Enum("Pending", "Cooking", "Ready", name="item_status_enum"), default="Pending")

    order = relationship("Order", back_populates="items")
    menu_item = relationship("MenuItem")

# --- SQLITE AUDIT LOG TABLE ---

class ActivityLog(AuditBase):
    __tablename__ = "activity_logs"
    id = Column(Integer, primary_key=True, index=True)
    actor_role = Column(String(20), nullable=False)
    actor_id = Column(Integer, nullable=True)
    action = Column(String(100), nullable=False)
    details = Column(Text, nullable=True)
    timestamp = Column(DateTime, default=datetime.utcnow)
```

Automatically Creating All Tables on App Startup (in `main.py`):
```python
from backend.database import mysql_engine, sqlite_engine, Base, AuditBase
from backend import models

Base.metadata.create_all(bind=mysql_engine)
AuditBase.metadata.create_all(bind=sqlite_engine)
```

