2. WRITING AUTOMATED API TESTS (`backend/tests/test_api.py`)
================================================================================
FastAPI's built-in `TestClient` lets you simulate HTTP requests directly against your Python app without needing to start a separate live Uvicorn server.

```python
import pytest
from fastapi.testclient import TestClient
from backend.main import app

client = TestClient(app)

# 1. Health Check Test
def test_api_health_check():
    response = client.get("/")
    assert response.status_code == 200
    assert response.json()["status"] == "online"

# 2. Public QR Menu Fetch Test
def test_get_public_menu():
    response = client.get("/api/menu/")
    assert response.status_code == 200
    assert isinstance(response.json(), list)

# 3. Pydantic Input Validation Test (Negative Quantity Must Fail with 422)
def test_reject_negative_order_quantity():
    bad_order_payload = {
        "table_id": 1,
        "items": [
            {
                "menu_item_id": 1,
                "quantity": -3,          # Invalid: schema requires ge=1
                "portion_size": "Full",
                "spice_choice": "Medium"
            }
        ]
    }
    response = client.post("/api/orders/", json=bad_order_payload)
    assert response.status_code == 422

# 4. Pydantic Rating Bounds Test (Rating > 5.0 Must Fail with 422)
def test_reject_invalid_star_rating():
    bad_review = {
        "table_id": 1,
        "bill_id": 1,
        "rating": 7.5,               # Invalid: schema requires le=5.0
        "comment": "Great food!"
    }
    response = client.post("/api/reviews", json=bad_review)
    assert response.status_code == 422

# 5. RBAC Security Test (Unauthenticated Menu Creation Must Fail with 401)
def test_block_unauthenticated_menu_creation():
    new_dish = {
        "name": "Unauthorized Dish",
        "category": "Main Course",
        "kitchen_station": "Curry",
        "price_full": 250.0,
        "is_veg": True
    }
    response = client.post("/api/menu/", json=new_dish)
    assert response.status_code == 401
```

