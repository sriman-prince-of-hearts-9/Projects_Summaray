4. PATH PARAMETERS, QUERY PARAMETERS & ERROR HANDLING (`HTTPException`)
================================================================================
FastAPI distinguishes between **Path Parameters** (identifying a specific item) and **Query Parameters** (filtering a list).

```python
from fastapi import APIRouter, HTTPException, Query, status
from typing import Optional

router = APIRouter(prefix="/api/menu", tags=["Menu"])

# Sample in-memory list for quick testing before connecting MySQL in Note 04
SAMPLE_MENU = [
    {"id": 1, "name": "Paneer Tikka", "category": "Main Course", "kitchen_station": "Tandoor",
     "price_half": 160.0, "price_full": 260.0, "is_veg": True, "allergens": "Dairy",
     "deal_badge": "Deal of the Day", "prep_time_mins": 15, "is_available": True},
    {"id": 2, "name": "Butter Chicken", "category": "Main Course", "kitchen_station": "Curry",
     "price_half": 210.0, "price_full": 340.0, "is_veg": False, "allergens": "Dairy,Nuts",
     "deal_badge": None, "prep_time_mins": 18, "is_available": True},
]

# Query Parameters: GET /api/menu?category=Main%20Course&veg_only=true&search=paneer
@router.get("/")
def get_menu(
    category: Optional[str] = Query(None, description="Filter by category"),
    veg_only: bool = Query(False, description="Show only vegetarian dishes"),
    search: Optional[str] = Query(None, description="Keyword search")
):
    results = [dish for dish in SAMPLE_MENU if dish["is_available"]]
    if category:
        results = [d for d in results if d["category"].lower() == category.lower()]
    if veg_only:
        results = [d for d in results if d["is_veg"] is True]
    if search:
        results = [d for d in results if search.lower() in d["name"].lower()]
    return results

# Path Parameter + HTTPException: GET /api/menu/1
@router.get("/{item_id}")
def get_single_dish(item_id: int):
    for dish in SAMPLE_MENU:
        if dish["id"] == item_id:
            return dish
    raise HTTPException(
        status_code=status.HTTP_404_NOT_FOUND,
        detail=f"Menu item with ID {item_id} not found"
    )

# POST Endpoint returning 201 Created
@router.post("/", status_code=status.HTTP_201_CREATED)
def create_dish(payload: MenuItemCreate):
    new_dish = payload.model_dump()
    new_dish["id"] = len(SAMPLE_MENU) + 1
    new_dish["is_available"] = True
    SAMPLE_MENU.append(new_dish)
    return new_dish
```

