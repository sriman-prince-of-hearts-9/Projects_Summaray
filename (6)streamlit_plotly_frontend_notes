5. 3-STATION KITCHEN DISPLAY SYSTEM (`3_Kitchen_Display.py`)
================================================================================
Splits active tickets across **Tandoor**, **Curry**, and **Drinks** columns with color-coded elapsed cooking timers (`Green` <= 5 min, `Yellow` <= 12 min, `Red` > 12 min).

```python
import streamlit as st
from frontend.utils.api_client import api_get, api_patch

st.title("👨‍🍳 Kitchen Display System (KDS)")

if st.button("🔄 Refresh Kitchen Tickets"):
    st.rerun()

active_items = api_get("/api/kds/active") or []

col_tandoor, col_curry, col_drinks = st.columns(3)
station_map = {
"Tandoor": col_tandoor,
"Curry": col_curry,
"Drinks": col_drinks
}
for station_name, column in station_map.items():
with column:
st.header(f"🔥 {station_name}")
station_tickets = [t for t in active_items if t["kitchen_station"] == station_name]
if not station_tickets:
st.info("No pending tickets.")
for ticket in station_tickets:
mins = ticket.get("elapsed_mins", 0)
color_badge = "🟢 NEW" if mins <= 5 else ("🟡 COOKING" if mins <= 12 else "🔴 LATE")
with st.container(border=True):
st.markdown(f"### Table {ticket['table_number']} — {color_badge} ({mins}m)")
st.write(f"{ticket['quantity']}x {ticket['dish_name']} ({ticket['portion_size']} | {ticket['spice_choice']})")
if ticket["item_status"] == "Pending":
if st.button("Start Cooking", key=f"start_{ticket['id']}"):
api_patch(f"/api/kds/items/{ticket['id']}/status", {"item_status": "Cooking"})
st.rerun()
elif ticket["item_status"] == "Cooking":
if st.button("✅ Mark Ready", key=f"ready_{ticket['id']}", type="primary"):
api_patch(f"/api/kds/items/{ticket['id']}/status", {"item_status": "Ready"})
st.rerun()
```

