4. CUSTOMER QR MENU, CART & CALL WAITER (`1_Customer_QR_Menu.py`)
================================================================================
Combines menu filters, customization selectors (Half/Full, Mild/Medium/Hot), live loyalty progress bar (`st.progress`), and instant Call Waiter buttons.

```python
import streamlit as st
from frontend.utils.api_client import api_get, api_post

table = st.session_state.get("table_info")
if not table:
    st.warning("Please scan a valid Table QR Code to open the menu.")
    st.stop()

st.title(f"🍛 Zaika Digital Menu — Table {table['table_number']}")

# Top Bar: Loyalty Progress & Call Waiter
col_pts, col_waiter = st.columns([2, 1])
with col_pts:
    pts = table.get("current_points", 160)
    st.write(f"**Loyalty Rewards:** {pts} / 200 pts (Free Mango Lassi at 200 pts!)")
    st.progress(min(pts / 200, 1.0))

with col_waiter:
    help_type = st.selectbox("Need Assistance?", ["Water", "Napkins", "Bill", "Other Help"])
    if st.button("🔔 Call Waiter", use_container_width=True):
        res = api_post("/api/alerts", {"table_id": table["id"], "request_type": help_type})
        if res:
            st.toast(f"Waiter alerted for {help_type}!")

st.divider()

# Menu Filters
f1, f2, f3 = st.columns([2, 1, 2])
category = f1.selectbox("Category", ["All", "Main Course", "Sides", "Drinks", "Deals"])
veg_only = f2.checkbox("Veg Only 🟢")
search = f3.text_input("Search Dish", placeholder="e.g., Paneer, Biryani...")

query_params = {"veg_only": veg_only}
if category != "All":
    query_params["category"] = category
if search:
    query_params["search"] = search

dishes = api_get("/api/menu", params=query_params) or []

# Dish Cards
for dish in dishes:
    with st.container(border=True):
        c1, c2, c3 = st.columns([3, 2, 1])
        badge = f" 🔥 `{dish['deal_badge']}`" if dish.get("deal_badge") else ""
        veg_dot = "🟢" if dish["is_veg"] else "🔴"
        c1.subheader(f"{veg_dot} {dish['name']}{badge}")
        c1.caption(f"Station: {dish['kitchen_station']} | Allergens: {dish.get('allergens') or 'None'}")

        size_opts = ["Full"] + (["Half"] if dish.get("price_half") else [])
        chosen_size = c2.radio("Portion", size_opts, horizontal=True, key=f"sz_{dish['id']}")
        chosen_spice = c2.selectbox("Spice", ["Mild", "Medium", "Hot"], index=1, key=f"sp_{dish['id']}")
        unit_price = dish["price_half"] if chosen_size == "Half" else dish["price_full"]

        c3.metric("Price", f"Rs.{unit_price}")
        if c3.button("Add +", key=f"add_{dish['id']}"):
            st.session_state.cart.append({
                "menu_item_id": dish["id"],
                "name": dish["name"],
                "portion_size": chosen_size,
                "spice_choice": chosen_spice,
                "quantity": 1,
                "unit_price": float(unit_price)
            })
            st.toast(f"Added {dish['name']} to cart!")

# Sidebar Cart & Order Submission
with st.sidebar:
    st.header("🛒 Your Order Cart")
    if not st.session_state.cart:
        st.info("Your cart is empty.")
    else:
        total = sum(i["unit_price"] * i["quantity"] for i in st.session_state.cart)
        for idx, item in enumerate(st.session_state.cart):
            st.write(f"**{item['quantity']}x {item['name']}** ({item['portion_size']}, {item['spice_choice']}) — Rs.{item['unit_price'] * item['quantity']}")
        st.divider()
        st.subheader(f"Subtotal: Rs.{total:.2f}")
        if st.button("🚀 Place Order Now", type="primary", use_container_width=True):
            payload = {
                "table_id": table["id"],
                "items": [
                    {
                        "menu_item_id": i["menu_item_id"],
                        "quantity": i["quantity"],
                        "portion_size": i["portion_size"],
                        "spice_choice": i["spice_choice"]
                    }
                    for i in st.session_state.cart
                ]
            }
            created = api_post("/api/orders/", payload)
            if created:
                st.session_state.cart = []
                st.success(f"Order #{created['order_id']} placed! Free WiFi: Zaika_Guest / spice2026")
```

