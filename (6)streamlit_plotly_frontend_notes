3. REUSABLE FASTAPI CLIENT (`frontend/utils/api_client.py`)
================================================================================
Instead of repeating `requests.get()` and `try/except` blocks on every page, wrap all HTTP calls in one clean helper module that automatically attaches the logged-in user's JWT token.

```python
import os
import requests
import streamlit as st

API_BASE_URL = os.getenv("API_BASE_URL", "http://localhost:8000")

def _get_headers() -> dict:
    token = st.session_state.get("jwt_token")
    if token:
        return {"Authorization": f"Bearer {token}"}
    return {}

def api_get(endpoint: str, params: dict = None):
    try:
        res = requests.get(
            f"{API_BASE_URL}{endpoint}",
            params=params,
            headers=_get_headers(),
            timeout=5
        )
        res.raise_for_status()
        return res.json()
    except requests.exceptions.RequestException as err:
        st.error(f"API Connection Error: {err}")
        return None

def api_post(endpoint: str, payload: dict):
    try:
        res = requests.post(
            f"{API_BASE_URL}{endpoint}",
            json=payload,
            headers=_get_headers(),
            timeout=5
        )
        if res.status_code >= 400:
            detail = res.json().get("detail", "Request failed")
            st.error(f"Error ({res.status_code}): {detail}")
            return None
        return res.json()
    except requests.exceptions.RequestException as err:
        st.error(f"API Connection Error: {err}")
        return None

def api_patch(endpoint: str, payload: dict = None):
    try:
        res = requests.patch(
            f"{API_BASE_URL}{endpoint}",
            json=payload or {},
            headers=_get_headers(),
            timeout=5
        )
        res.raise_for_status()
        return res.json()
    except requests.exceptions.RequestException as err:
        st.error(f"API Update Error: {err}")
        return None
```

