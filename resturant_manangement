4. RELATIONAL DATABASE DESIGN (10 MYSQL TABLES + 1 SQLITE TABLE)

TABLE 1: users (MySQL) — Staff, Kitchen, and Owner accounts
• id: INT, Primary Key, Auto Increment
• full_name: VARCHAR(100), Not Null
• email: VARCHAR(120), Unique, Not Null
• password_hash: VARCHAR(255), Not Null
• role: ENUM('staff', 'kitchen', 'owner'), Not Null
• is_active: BOOLEAN, Default TRUE
• created_at: DATETIME, Default Current Timestamp
TABLE 2: restaurant_tables (MySQL) — Floor map & QR tokens (T1–T6)
• id: INT, Primary Key, Auto Increment
• table_number: VARCHAR(10), Unique, Not Null (T1 to T6)
• capacity: INT, Not Null
• qr_token: VARCHAR(64), Unique, Not Null
• status: ENUM('Empty', 'Ordering', 'Eating', 'Bill Requested', 'Needs Help'), Default 'Empty'
• current_points: INT, Default 0
TABLE 3: menu_items (MySQL) — Dishes, pricing, allergens, spice & KDS station
• id: INT, Primary Key, Auto Increment
• name: VARCHAR(100), Not Null
• category: ENUM('Main Course', 'Sides', 'Drinks', 'Deals'), Not Null
• kitchen_station: ENUM('Tandoor', 'Curry', 'Drinks'), Not Null
• price_half: DECIMAL(10,2), Nullable
• price_full: DECIMAL(10,2), Not Null
• is_veg: BOOLEAN, Default TRUE
• spice_levels: VARCHAR(50), Default 'Mild,Medium,Hot'
• allergens: VARCHAR(100), Nullable (e.g., 'Dairy,Nuts,Gluten')
• deal_badge: VARCHAR(50), Nullable (e.g., 'Deal of the Day')
• prep_time_mins: INT, Default 15
• image_url: VARCHAR(255), Nullable
• is_available: BOOLEAN, Default TRUE
TABLE 4: orders (MySQL) — Order batches & cooking timers
• id: INT, Primary Key, Auto Increment
• table_id: INT, Foreign Key -> restaurant_tables.id, Not Null
• confirmed_by: INT, Foreign Key -> users.id, Nullable
• status: ENUM('Placed', 'Confirmed', 'Cooking', 'Ready', 'Served', 'Closed'), Default 'Placed'
• placed_at: DATETIME, Default Current Timestamp
• cooking_started_at: DATETIME, Nullable
• estimated_ready_at: DATETIME, Nullable
TABLE 5: order_items (MySQL) — Individual items within each order
• id: INT, Primary Key, Auto Increment
• order_id: INT, Foreign Key -> orders.id (ON DELETE CASCADE), Not Null
• menu_item_id: INT, Foreign Key -> menu_items.id, Not Null
• quantity: INT, Not Null
• portion_size: ENUM('Half', 'Full'), Default 'Full'
• spice_choice: ENUM('Mild', 'Medium', 'Hot'), Default 'Medium'
• unit_price: DECIMAL(10,2), Not Null
• item_status: ENUM('Pending', 'Cooking', 'Ready'), Default 'Pending'
TABLE 6: bills (MySQL) — Table invoices, GST, tips & split mode
• id: INT, Primary Key, Auto Increment
• table_id: INT, Foreign Key -> restaurant_tables.id, Not Null
• subtotal: DECIMAL(10,2), Not Null
• gst_amount: DECIMAL(10,2), Not Null
• tip_amount: DECIMAL(10,2), Default 0.00
• grand_total: DECIMAL(10,2), Not Null
• split_type: ENUM('None', 'Equal_2', 'Equal_3', 'Equal_4', 'By_Item'), Default 'None'
• bill_status: ENUM('Unpaid', 'Partially_Paid', 'Paid'), Default 'Unpaid'
• created_at: DATETIME, Default Current Timestamp
TABLE 7: payments (MySQL) — Individual & split payment transactions
• id: INT, Primary Key, Auto Increment
• bill_id: INT, Foreign Key -> bills.id, Not Null
• amount_paid: DECIMAL(10,2), Not Null
• payment_method: ENUM('Cash', 'Card', 'Bank Transfer', 'Google Pay', 'Apple Pay'), Not Null
• customer_email: VARCHAR(120), Nullable
• paid_at: DATETIME, Default Current Timestamp
TABLE 8: call_waiter_requests (MySQL) — Live alerts & staff response SLA
• id: INT, Primary Key, Auto Increment
• table_id: INT, Foreign Key -> restaurant_tables.id, Not Null
• request_type: ENUM('Water', 'Napkins', 'Bill', 'Other Help'), Not Null
• status: ENUM('Pending', 'Resolved'), Default 'Pending'
• resolved_by: INT, Foreign Key -> users.id, Nullable
• created_at: DATETIME, Default Current Timestamp
• resolved_at: DATETIME, Nullable
• response_seconds: INT, Nullable
TABLE 9: reviews (MySQL) — Customer ratings & feedback
• id: INT, Primary Key, Auto Increment
• table_id: INT, Foreign Key -> restaurant_tables.id, Not Null
• bill_id: INT, Foreign Key -> bills.id, Not Null
• rating: DECIMAL(2,1), Not Null (1.0 to 5.0)
• comment: TEXT, Nullable
• created_at: DATETIME, Default Current Timestamp
TABLE 10: rewards (MySQL) — Guest loyalty points & Spice Quiz scores
• id: INT, Primary Key, Auto Increment
• guest_session_id: VARCHAR(64), Unique, Not Null
• table_id: INT, Foreign Key -> restaurant_tables.id, Not Null
• points_balance: INT, Default 0
• quiz_score: INT, Default 0
• free_item_unlocked: BOOLEAN, Default FALSE
• updated_at: DATETIME, Auto-Update Current Timestamp
TABLE 11: activity_logs (SQLite — audit_logs.db) — Fast local audit trail
• id: INTEGER, Primary Key, Autoincrement
• actor_role: TEXT, Not Null ('customer', 'staff', 'kitchen', 'owner')
• actor_id: INTEGER, Nullable
• action: TEXT, Not Null (e.g., 'ORDER_PLACED', 'KDS_READY', 'BILL_PAID')
• details: TEXT, Nullable
• timestamp: DATETIME, Default Current Timestamp

