Q7 (Python). "Given a list of order item dictionaries, write a Python function that groups active dish tickets by their kitchen_station ('Tandoor', 'Curry', 'Drinks')."
Answer:
def group_kds_tickets(items: list[dict]) -> dict[str, list[str]]:
    grouped = {"Tandoor": [], "Curry": [], "Drinks": []}
    for item in items:
        station = item.get("kitchen_station")
        if station in grouped and item.get("item_status") != "Ready":
            entry = f"{item['quantity']}x {item['name']} (Table {item['table_number']})"
            grouped[station].append(entry)
    return grouped

